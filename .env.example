# 复制为 .env 后填入自己的值。.env 已被 gitignore，不要提交真实密钥。
# Spring Boot 会把这些环境变量绑定到 application.yml 里的同名配置。

# 必填。没有真实密钥时也可以编译；调用模型会失败。
SPRING_AI_OPENAI_API_KEY=

# OpenAI 兼容接口的根地址。Spring AI 会自己拼接 /v1/...，这里一般不要再写 /v1。
# 官方：https://api.openai.com
# DeepSeek 示例：https://api.deepseek.com
SPRING_AI_OPENAI_BASE_URL=https://api.openai.com

# 对话模型名。按你的网关实际支持的名字填写。
SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=gpt-4o-mini

# 仅 04-memory-rag 的嵌入模型需要。纯对话网关可以先不填，跳过入库。
SPRING_AI_OPENAI_EMBEDDING_OPTIONS_MODEL=text-embedding-3-small
