<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>dev.learn</groupId>
  <artifactId>spring-ai-learn</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>spring-ai-learn</name>
  <description>Spring AI 分阶段学习：Chat、Stream、Tools、RAG、Agent</description>

  <modules>
    <module>01-chat</module>
    <module>02-stream</module>
    <module>03-tools</module>
    <module>04-memory-rag</module>
    <module>05-agent-workflow</module>
  </modules>

  <properties>
    <java.version>17</java.version>
    <spring-ai.version>1.1.8</spring-ai.version>
    <maven.compiler.parameters>true</maven.compiler.parameters>
  </properties>

  <!--
    Spring AI 1.1.8 是与 Spring Boot 3.5 配套的当前稳定线。
    Spring AI 2.0.x 需要 Spring Boot 4，不放进这个 Boot 3 学习仓库。
    子模块不要写 Spring AI 的 version，统一由这个 BOM 管理。
  -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
